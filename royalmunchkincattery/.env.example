# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Local-only media serving; use S3 for deployed production media.
SERVE_LOCAL_MEDIA=True
DJANGO_ALLOWED_HOSTS=royalmunchkincattery.com,www.royalmunchkincattery.com,*.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://royalmunchkincattery.com,https://www.royalmunchkincattery.com,https://*.onrender.com
SITE_DOMAIN=royalmunchkincattery.com
TIME_ZONE=America/Chicago


# --- Gmail SMTP (reservation, contact, waitlist notifications) ---
# 1. Enable 2-Step Verification on the Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords.
# 3. Put the generated 16-character App Password below (Google may display it
#    with spaces; enter it without spaces). Do not use your regular Gmail password.
# 4. Keep the real password only in your ignored local .env or deployment secret
#    settings. Never commit it or put it in .env.example.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Gmail submission on port 587 uses STARTTLS; do not enable implicit SSL here.
EMAIL_USE_TLS=True
EMAIL_HOST_USER=dawingthomas@gmail.com
EMAIL_HOST_PASSWORD=egrqorjdaabqdxer
# Use the authenticated Gmail address as the sender to avoid Gmail sender rejection.
DEFAULT_FROM_EMAIL=Royal Munchkin Cattery <dawingthomas@gmail.com>
ADMIN_NOTIFICATION_EMAIL=dawingthomas@gmail.com

# --- SEO and contact (all optional, hidden when blank) ---
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
SITE_PHONE=+17208196325
WHATSAPP_NUMBER=
TWITTER_HANDLE=

# --- Security ---
SECURE_SSL_REDIRECT=True
TRUSTED_PROXY_COUNT=1
